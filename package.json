        "typescript"
    ],
    "license": "Unlicense",
    "name": "nodify",
    "os": [
        "linux"
    ],
    "private": true,
    "repository": {
        "type": "git",
        "url": "git+https://github.com/madliani/nodify.git"
    },
    "scripts": {
        "build": "tsdown",
        "build:release": "tsdown --minify --shims",
        "check:format": "prettier ./ --write --ignore-unknown",
        "check:lint": "eslint --fix && tsc",
        "check:spell": "cspell ./",
        "start": "env-cmd -- node ./dist/nodify.mjs",
        "start:release": "node ./dist/nodify.mjs",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "test:ui": "vitest watch --ui --coverage.enabled=true"
    },
    "type": "module",
    "version": "1.0.6"
}
