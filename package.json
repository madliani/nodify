        "@vitest/ui": "5.0.0",
        "cspell": "10.2.2",
        "env-cmd": "11.0.0",
        "eslint": "10.10.0",
        "eslint-import-resolver-typescript": "4.4.5",
        "eslint-plugin-import": "2.32.0",
        "eslint-plugin-no-secrets": "2.3.3",
        "eslint-plugin-perfectionist": "5.11.0",
        "globals": "17.12.0",
        "prettier": "3.9.6",
        "supertest": "7.2.2",
        "typescript-eslint": "8.69.0",
        "vitest": "5.0.0"
    },
    "engineStrict": false,
    "engines": {
        "node": "v26.7.0"
    },
    "homepage": "https://github.com/madliani/nodify#readme",
    "keywords": [
        "expressjs",
        "nodejs",
        "nodify",
